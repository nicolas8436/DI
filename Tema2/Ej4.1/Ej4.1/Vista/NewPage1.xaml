<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Ej4._1.Vista.NewPage1"
    Title="JuegoAlineacion2">

    <Grid Padding="26" RowSpacing="16" ColumnSpacing="10" 
          RowDefinitions="50,50,*" ColumnDefinitions="*,*,*,*,*">

        <Label Grid.Row="0" Grid.Column="0" 
               Text="Horizontal" 
               VerticalOptions="Center"/>
        <Button Grid.Row="0" Grid.Column="1" Text="Start" />
        <Button Grid.Row="0" Grid.Column="2" Text="Center" />
        <Button Grid.Row="0" Grid.Column="3" Text="End" />
        <Button Grid.Row="0" Grid.Column="4" Text="Fill" />

        <Label Grid.Row="1" Grid.Column="0" 
               Text="Vertical" 
               VerticalOptions="Center"/>
        <Button Grid.Row="1" Grid.Column="1" Text="Start" />
        <Button Grid.Row="1" Grid.Column="2" Text="Center" />
        <Button Grid.Row="1" Grid.Column="3" Text="End" />
        <Button Grid.Row="1" Grid.Column="4" Text="Fill" />

        <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" 
               x:Name="target" 
               BackgroundColor="Silver" 
               Text="Hello" />

    </Grid>
</ContentPage>