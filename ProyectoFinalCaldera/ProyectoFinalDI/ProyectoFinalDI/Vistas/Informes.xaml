<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProyectoFinalDI.Vistas.Informes"
             xmlns:chart="clr-namespace:Syncfusion.Maui.Toolkit.Charts;assembly=Syncfusion.Maui.Toolkit"
             Title="Historial por Aulas"
             Style="{DynamicResource Fondo}">

    <Shell.TitleView>
        <HorizontalStackLayout HorizontalOptions="Fill">
            <Image Style="{DynamicResource ImgCabecera}"/>
            <Label x:Name="LabelTitulo"
                   Text="{DynamicResource TituloCabeceraAulas}"
                   Style="{DynamicResource Titulo}"
                   VerticalOptions="Center"
                   Margin="10,0,0,0"/>
        </HorizontalStackLayout>
    </Shell.TitleView>

    <ScrollView>
        <VerticalStackLayout Padding="15" Spacing="20">

            <HorizontalStackLayout Spacing="15" HorizontalOptions="Start">
                <Label Text="{DynamicResource Picker}"
                       Style="{DynamicResource CuerpoNegrita}"
                       VerticalOptions="Center"
                       Margin="0,30,0,0"/>

                <Picker x:Name="PickerAulas"
                        Style="{DynamicResource PickerAula}"
                        WidthRequest="200"
                        SelectedIndexChanged="PickerAulas_SelectedIndexChanged" />
            </HorizontalStackLayout>

            <!-- INICIO INFORME 1 -->
            <Frame x:Name="FrameGrafico" 
                   Style="{DynamicResource FrameGraficos}" 
                   IsVisible="False" 
                   HeightRequest="450">

                <VerticalStackLayout Spacing="10">
                    <Label x:Name="LabelAulaSeleccionada" 
                           Style="{DynamicResource CuerpoNegrita}" 
                           HorizontalTextAlignment="Center"/>

                    <chart:SfCartesianChart x:Name="GraficoPrincipal">
                        <chart:SfCartesianChart.XAxes>
                            <chart:CategoryAxis />
                        </chart:SfCartesianChart.XAxes>

                        <chart:SfCartesianChart.YAxes>
                            <chart:NumericalAxis Minimum="0" Maximum="50">
                                <chart:NumericalAxis.Title>
                                    <chart:ChartAxisTitle Text="{DynamicResource Informe1Y}" />
                                </chart:NumericalAxis.Title>
                            </chart:NumericalAxis>
                        </chart:SfCartesianChart.YAxes>

                        <chart:SfCartesianChart.Series>
                            <chart:ColumnSeries x:Name="SeriesGrafico"
                                                XBindingPath="FechaHoraFormateada" 
                                                YBindingPath="TEMP_ACT"
                                                Fill="{DynamicResource colorGraficos}"
                                                EnableTooltip="True"
                                                Width="0.7" />
                        </chart:SfCartesianChart.Series>
                    </chart:SfCartesianChart>
                </VerticalStackLayout>
            </Frame>
            
            <!-- INICIO INFORME 2 -->
            <Frame x:Name="FrameTiempos" 
                   Style="{DynamicResource FrameGraficos}" 
                   IsVisible="False" 
                   HeightRequest="400">

                <VerticalStackLayout Spacing="10">
                    <Label Text="{DynamicResource Informe2Titulo}" 
                           HorizontalTextAlignment="Center" 
                           Style="{DynamicResource CuerpoNegrita}"/>

                    <chart:SfCartesianChart HeightRequest="300">
                        <chart:SfCartesianChart.XAxes>
                            <chart:CategoryAxis />
                        </chart:SfCartesianChart.XAxes>

                        <chart:SfCartesianChart.YAxes>
                            <chart:NumericalAxis>
                                <chart:NumericalAxis.Title>
                                    <chart:ChartAxisTitle Text="{DynamicResource Informe2Y}" />
                                </chart:NumericalAxis.Title>
                            </chart:NumericalAxis>
                        </chart:SfCartesianChart.YAxes>

                        <chart:SfCartesianChart.Series>
                            <chart:ColumnSeries x:Name="SeriesTiempos"
                                                XBindingPath="Tipo"
                                                YBindingPath="MinutosActivo"
                                                ShowDataLabels="True">
                                <chart:ColumnSeries.PaletteBrushes>
                                    <SolidColorBrush Color="{DynamicResource VerdeOscuro}"/>
                                    <SolidColorBrush Color="{DynamicResource AzulOscAdd}"/>
                                </chart:ColumnSeries.PaletteBrushes>
                            </chart:ColumnSeries>
                        </chart:SfCartesianChart.Series>
                    </chart:SfCartesianChart>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>