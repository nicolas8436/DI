<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Frutas.Vistas.Inicio.InicioContentPage"
             Title="Inicio Content Page">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="8*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <Image Source="frutas.jpg" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="3" Grid.RowSpan="3"/>

        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Grid.Column="1" Grid.Row="1">
            <Entry MinimumWidthRequest="200" MaximumWidthRequest="300" Placeholder="Usuario"/>
            <Entry MinimumWidthRequest="200" MaximumWidthRequest="300"/>
            <Button Text="Login" MinimumWidthRequest="200" MaximumWidthRequest="300" Clicked="Button_Clicked"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>