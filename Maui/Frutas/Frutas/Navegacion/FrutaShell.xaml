<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Frutas.Navegacion.FrutaShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Frutas"
    xmlns:pageFrutas="clr-namespace:Frutas.Vistas.Frutas"
    Title="Frutas">

    <ShellContent
        Title="Fresas"
        ContentTemplate="{DataTemplate pageFrutas:FresasContentPage}"
        Route="FresasContentPage" />
    <ShellContent
        Title="Melocoton"
        ContentTemplate="{DataTemplate pageFrutas:MelocotonContentPage}"
        Route="MelocotonContentPage" />
</Shell>
